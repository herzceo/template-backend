# HTTP
NAME                        = MyApp
DESCRIPTION                 = My application description
VERSION                     = 0.1.0
LOG_LEVEL                   = INFO
HOST                        = 0.0.0.0
PORT                        = 8000
SCALAR_VERSION              = 1.32.0
OPENAPI_PATH                = /docs
OPENAPI_EXISTS              = true
CORS_ALLOW_ORIGINS          = ["http://localhost:3000"]
CORS_ALLOW_HEADERS          = ["*"]
CORS_ALLOW_METHODS          = ["*"]
CORS_EXPOSE_HEADERS         = ["*"]
CORS_MAX_AGE                = 600

# Database
POSTGRES_HOST               = localhost
POSTGRES_PORT               = 5432
POSTGRES_DB                 = myapp
POSTGRES_USER               = postgres
POSTGRES_PASS               = change-me-in-production
POSTGRES_DRIVER             = psycopg
POSTGRES_POOL_SIZE          = 100
POSTGRES_MAX_OVERFLOW       = 10
POSTGRES_MAX_CONNECTIONS    = 150

# Redis
REDIS_HOST                  = localhost
REDIS_PORT                  = 6379
# REDIS_PASSWORD            = your-redis-password   # optional

# Security
# Must be a random secret of at least 32 characters — used to sign OAuth state tokens
OAUTH_STATE_SECRET          = change-this-to-a-random-32-char-secret-now

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID            = 123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET        = GOCSPX-abcdefghijklmnopqrstuvwxyz012345
GOOGLE_REDIRECT_URI         = http://localhost:8000/v1/auth/oauth/google/callback

# GitHub OAuth — https://github.com/settings/developers
GITHUB_CLIENT_ID            = Iv1.abcdef1234567890ab
GITHUB_CLIENT_SECRET        = abcdef1234567890abcdef1234567890abcdef12
GITHUB_REDIRECT_URI         = http://localhost:8000/v1/auth/oauth/github/callback

# Discord OAuth — https://discord.com/developers/applications
DISCORD_CLIENT_ID           = 1234567890123456789
DISCORD_CLIENT_SECRET       = abcdefghijklmnopqrstuvwxyz012345AB
DISCORD_REDIRECT_URI        = http://localhost:8000/v1/auth/oauth/discord/callback

# Email — Resend (https://resend.com/api-keys) — required for queue worker
RESEND_API_KEY              = re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# S3-compatible object storage — optional, omit to disable file uploads
# S3_ACCESS_KEY_ID          = AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY      = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_REGION                 = us-east-1
# S3_BUCKET                 = myapp-assets
# S3_ENDPOINT_URL           = https://s3.us-east-1.amazonaws.com   # or MinIO URL for local dev
# S3_PRESIGNED_URL_EXPIRY   = 3600

# Analytics — Amplitude (https://app.amplitude.com) — optional
# AMPLITUDE_API_KEY         = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps (https://console.cloud.google.com/apis) — optional
# GOOGLE_MAPS_API_KEY       = AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenRouter LLM gateway (https://openrouter.ai/keys) — optional, set the key to enable
# OPENROUTER_API_KEY        = sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL          = openai/gpt-4o-mini
# OPENROUTER_BASE_URL       = https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER   = https://your-app.example.com   # OpenRouter attribution, optional
# OPENROUTER_TITLE          = Your App Name                  # OpenRouter attribution, optional

# Queue worker settings — all optional, defaults shown
# WORKER_NAME               = worker
# WORKER_CONCURRENCY        = 10
# WORKER_POLL_INTERVAL      = 5.0
# WORKER_HEARTBEAT_INTERVAL = 10.0
# WORKER_STALLED_AFTER      = 120
# WORKER_METRICS_PORT       = 9091   # Prometheus exporter port for the queue worker

# Monitoring — Grafana admin (prod stack only, docker-compose.prod.yaml)
GF_SECURITY_ADMIN_USER      = admin
GF_SECURITY_ADMIN_PASSWORD  = change-me-in-production
