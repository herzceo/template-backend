{
  "uid": "queue-overview",
  "title": "Queue Worker",
  "tags": ["template", "queue"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workers Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(queue_worker_up)" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Jobs In Progress",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(queue_jobs_in_progress)" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Jobs Succeeded (5m rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(rate(queue_jobs_total{status=\"succeeded\"}[5m]))" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs Failed (5m rate)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.001 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(queue_jobs_total{status=\"failed\"}[5m]))" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Job Throughput by Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (status) (rate(queue_jobs_total[5m]))", "legendFormat": "{{status}}" } ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Job Duration p95 by Queue",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(queue_job_duration_seconds_bucket[5m])))", "legendFormat": "{{queue}}" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput by Queue",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum by (queue) (rate(queue_jobs_total[5m]))", "legendFormat": "{{queue}}" } ]
    }
  ]
}
