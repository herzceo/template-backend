{
  "uid": "postgres-overview",
  "title": "PostgreSQL",
  "tags": ["template", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "pg_up" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(pg_stat_database_numbackends)" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit[5m])) / (sum(rate(pg_stat_database_blks_hit[5m])) + sum(rate(pg_stat_database_blks_read[5m])))" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deadlocks (5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(increase(pg_stat_database_deadlocks[5m]))" } ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transactions / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit[5m]))", "legendFormat": "commit" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback[5m]))", "legendFormat": "rollback" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Connections by Database",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [ { "refId": "A", "expr": "pg_stat_database_numbackends", "legendFormat": "{{datname}}" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Tuples Returned / Fetched",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_tup_returned[5m]))", "legendFormat": "returned" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_tup_fetched[5m]))", "legendFormat": "fetched" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database Size",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "pg_database_size_bytes", "legendFormat": "{{datname}}" } ]
    }
  ]
}
