{
  "uid": "prometheus-overview",
  "title": "Prometheus",
  "tags": ["template", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [ { "refId": "A", "expr": "sum(up)" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets Down",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "count(up == 0) or vector(0)" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Head Series",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [ { "refId": "A", "expr": "prometheus_tsdb_head_series" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Samples Appended / sec",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [ { "refId": "A", "expr": "rate(prometheus_tsdb_head_samples_appended_total[5m])" } ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Target Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [ { "refId": "A", "expr": "up", "format": "table", "instant": true } ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape Duration by Job",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "avg by (job) (scrape_duration_seconds)", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "TSDB Head Series",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [ { "refId": "A", "expr": "prometheus_tsdb_head_series", "legendFormat": "series" } ]
    }
  ]
}
